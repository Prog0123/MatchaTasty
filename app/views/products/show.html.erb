<!-- 詳細ページ -->
<div class="container mx-auto p-4 space-y-6">

  <!-- 商品情報カード -->
  <div class="bg-white rounded-lg shadow p-6 relative max-w-4xl mx-auto">

    <!-- 編集/削除ボタン -->
    <% if user_signed_in? && @product.user == current_user %>
      <div class="absolute top-4 right-4 flex space-x-2">
        <%= link_to "編集", edit_product_path(@product), class: "btn btn-sm btn-outline btn-primary" %>
        <%= link_to "削除", product_path(@product), data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？" }, class: "btn btn-sm btn-outline btn-error" %>
      </div>
    <% end %>

    <!-- 投稿者名 -->
    <div class="flex items-center space-x-4 text-gray-500 text-base mb-6">
      <div class="w-8 h-8 bg-gray-200 rounded-full flex items-center justify-center">
        <svg class="w-5 h-5 text-gray-600" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z" clip-rule="evenodd"></path>
        </svg>
      </div>
      <span><%= @product.user&.name || "匿名" %></span>
      <span class="text-gray-400 text-sm">
        <%= @product.created_at.strftime("%Y年%m月%d日 %H:%M") %>
      </span>
    </div>

    <!-- 商品名 -->
    <h1 class="text-3xl font-bold mb-2"><%= @product.name %></h1>

    <!-- 画像とレーダーチャート -->
    <% if @review.present? && @chart_data.present? %>
      <div class="flex flex-col md:flex-row gap-6 items-start mt-4">
        <!-- 左側：商品画像と詳細情報 -->
        <div class="w-full md:w-1/2 space-y-4">
          <!-- 商品画像 -->
          <% if @product.image.attached? %>
            <%= image_tag @product.image, class: "w-full h-64 max-w-sm object-cover rounded shadow mb-4" %>
          <% else %>
            <div class="w-full max-w-sm h-64 bg-gray-100 flex items-center justify-center rounded">No Image</div>
          <% end %>

          <!-- 商品詳細情報 -->
          <div class="grid grid-cols-2 gap-4 max-w-sm mt-10">
            <!-- 店舗名・価格 -->
            <div>
              <h4 class="font-semibold text-gray-700 text-base mb-1">店舗名</h4>
              <p class="text-gray-600 text-base"><%= @product.shop_name.present? ? @product.shop_name : "未設定" %></p>
            </div>
            <div>
              <h4 class="font-semibold text-gray-700 text-base mb-1">価格</h4>
              <p class="text-gray-600 text-base"><%= @product.price.present? ? "#{number_with_delimiter(@product.price)}円" : "未設定" %></p>
            </div>

            <!-- カテゴリ・タグ -->
            <div>
              <h4 class="font-semibold text-gray-700 text-base mb-1">カテゴリ</h4>
              <p class="text-gray-600 text-base"><%= @product.category_japanese %></p>
            </div>
            <div>
              <h4 class="font-semibold text-gray-700 text-base mb-1">タグ</h4>
              <% if @product.tags.present? %>
                <div class="flex flex-wrap gap-1">
                  <% @product.tags.each do |tag| %>
                    <%= link_to products_path(tag: tag.name), class: "badge badge-xs badge-outline hover:badge-primary transition-colors cursor-pointer" do %>
                      <%= tag.name %>
                    <% end %>
                  <% end %>
                </div>
              <% else %>
                <p class="text-gray-600 text-base">なし</p>
              <% end %>
            </div>

            <!-- 濃さ・総合評価 -->
            <div>
              <h4 class="font-semibold text-gray-700 text-base mb-1">濃さ</h4>
              <div class="flex items-center space-x-1">
                <div class="flex">
                  <% @review.richness.to_i.times do %>
                    <span class="text-green-600 text-base">🍵</span>
                  <% end %>
                </div>
                <span class="text-xs font-bold text-gray-600"><%= @review.richness.to_i %>/5</span>
              </div>
            </div>
            <div>
              <h4 class="font-semibold text-gray-700 text-base mb-1">総合評価</h4>
              <% if @average_score.present? %>
                <div class="flex items-center space-x-1">
                  <div class="flex">
                    <% 5.times do |i| %>
                      <% if i < @average_score.round %>
                        <span class="text-yellow-400 text-base">★</span>
                      <% else %>
                        <span class="text-gray-300 text-base">★</span>
                      <% end %>
                    <% end %>
                  </div>
                  <span class="text-xs font-bold text-gray-600"><%= number_with_precision(@average_score, precision: 1) %>/5.0</span>
                </div>
              <% else %>
                <p class="text-gray-500 text-base">未評価</p>
              <% end %>
            </div>
          </div>

          <!-- Google Map表示 -->
          <% if @product.has_location? %>
            <div class="bg-gray-50 p-3 rounded max-w-sm mt-6">
              <% if @product.address.present? %>
                <p class="text-sm text-gray-600 mb-3">
                  <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                  <%= @product.address %>
                </p>
              <% end %>
              <div 
                data-controller="google-map"
                data-google-map-latitude-value="<%= @product.latitude %>"
                data-google-map-longitude-value="<%= @product.longitude %>"
                data-google-map-shop-name-value="<%= @product.shop_name %>"
                class="w-full rounded shadow-sm bg-gray-100"
                style="height: 200px;">
                <p class="text-center pt-20 text-gray-500 text-sm">地図を読み込み中...</p>
              </div>
            </div>
          <% end %>
          </div>

        <!-- 右側：レーダーチャートとレビュー -->
        <div class="w-full md:w-1/2 flex flex-col justify-between min-h-full">
          <div class="space-y-6">
          <!-- レーダーチャート -->
          <div class="flex justify-center">
            <div class="chart-container" style="height: 300px; width: 300px;">
              <canvas
                data-controller="review-radar"
                data-review-radar-data-value="<%= @chart_data[:chart_config].to_json %>"
                width="300"
                height="300">
              </canvas>
            </div>
          </div>

          <!-- レーダーチャートの数値表示 -->
          <div class="bg-gray-50 p-4 rounded">
            <h4 class="font-semibold text-gray-700 mb-3 text-center">評価詳細</h4>
            <div class="grid grid-cols-2 gap-3">
              <% @chart_data[:values].each do |item| %>
                <div class="flex justify-between items-center">
                  <span class="text-base text-gray-600"><%= item[:label] %></span>
                  <span class="text-base font-bold text-gray-800"><%= item[:value].to_i %>/5</span>
                </div>
              <% end %>
            </div>
          </div>

          <!-- レビューコメント -->
          <% if @review.comment.present? %>
            <div class="bg-gray-50 p-4 rounded">
              <h4 class="font-semibold text-gray-700 mb-2">レビュー</h4>
              <p class="text-base text-gray-600"><%= simple_format(@review.comment) %></p>
            </div>
          <% end %>

            <!-- Xシェアボタン・いいねボタン -->
            <% if @review.present? %>
              <div class="flex items-center gap-3 justify-end mt-4">
                <!-- Xシェアボタン -->
                <% 
                  share_url_encoded = CGI.escape(@share_url || '')
                  share_text_encoded = CGI.escape(@share_text || '')
                  share_hashtags_encoded = (@share_hashtags || []).join(',')
                  twitter_url = "https://twitter.com/intent/tweet?text=#{share_text_encoded}&url=#{share_url_encoded}&hashtags=#{share_hashtags_encoded}"
                %>
                
                <%= link_to twitter_url, 
                            target: '_blank', 
                            rel: 'noopener noreferrer',
                            class: "inline-flex items-center px-4 py-2 bg-black hover:bg-gray-800 text-white text-sm font-medium rounded-lg transition-colors duration-200 shadow-sm hover:shadow-md",
                            style: "background-color: #000000; color: #ffffff; text-decoration: none;" do %>
                  <svg class="w-4 h-4 mr-2" style="width: 16px; height: 16px; margin-right: 8px;" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                  Xでシェア
                <% end %>

                <!-- いいねボタン -->
                <%= render "likes/like_button", review: @review, size: "md" %>
              </div>
            <% else %>
              <div class="flex justify-end mt-4">
                <button class="inline-flex items-center px-4 py-2 bg-gray-300 text-gray-500 text-sm font-medium rounded-lg cursor-not-allowed" 
                        style="background-color: #d1d5db; color: #6b7280;" 
                        disabled>
                  <svg class="w-4 h-4 mr-2" style="width: 16px; height: 16px; margin-right: 8px;" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                  </svg>
                  Xでシェア（レビュー未登録）
                </button>
              </div>
            <% end %>
            </div>

          </div>
        </div>
      </div>
    <% end %>

    <!-- レビューがない場合の表示 -->
    <% unless @review.present? && @chart_data.present? %>
      <div class="mt-6 pt-6 border-t border-gray-200">
        <p class="text-gray-500">まだレビューはありません。</p>
      </div>
    <% end %>

  </div>

<!-- コメント一覧 -->
<div class="bg-white rounded-lg shadow p-6 max-w-4xl mx-auto">
  <h2 class="text-2xl font-semibold mb-6">コメント</h2>

  <% if @review.present? %>
    <div class="space-y-6">
      <!-- コメント投稿フォーム -->
      <div id="comment-form">
        <%= render "comments/comment_form", review: @review %>
      </div>

      <!-- コメント一覧 -->
      <div id="comments-list" class="space-y-4">
        <% if @review.comments.newest_first.any? %>
          <p class="text-sm text-gray-600 mb-4">
            <%= @review.comments.count %>件のコメント
          </p>
          <%= render @review.comments.newest_first, collection: @review.comments.newest_first, as: :comment %>
        <% else %>
          <p class="text-center text-gray-500 py-8">
            まだコメントはありません。
          </p>
        <% end %>
      </div>
    </div>
  <% else %>
    <p class="text-gray-500">レビューがないため、コメント機能は利用できません。</p>
  <% end %>
</div>

  <!-- 戻るボタン -->
  <div class="max-w-4xl mx-auto flex mt-4 mb-4">
    <%= link_to "商品一覧に戻る", products_path, class: "btn btn-outline" %>
  </div>
</div>